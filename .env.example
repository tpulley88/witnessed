# Public mobile configuration. Never place provider secrets in EXPO_PUBLIC variables.
EXPO_PUBLIC_API_URL=https://your-site.example

# Server-side Netlify Function configuration
OPENAI_API_KEY=replace-in-deployment-environment
UPSTASH_REDIS_REST_URL=https://replace-with-upstash-endpoint
UPSTASH_REDIS_REST_TOKEN=replace-in-deployment-environment
WITNESSED_SYSTEM_PROMPT=optional-server-side-prompt
